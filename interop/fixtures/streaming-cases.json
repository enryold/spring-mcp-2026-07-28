  {
    "id": "stream-elicitation-has-no-independent-request",
    "profile": "conformance",
    "requirements": [
      "P17.01"
    ],
    "request": {
      "mcpMethod": "tools/call",
      "mcpName": "test_streaming_elicitation",
      "id": "elicitation-call",
      "params": {
        "name": "test_streaming_elicitation",
        "arguments": {}
      },
      "clientCapabilities": {
        "elicitation": {}
      }
    },
    "assert": {
      "status": 200,
      "contentType": "text/event-stream",
      "terminalId": "elicitation-call",
      "forbiddenIndependentRequests": true,
      "resultType": "input_required",
      "resultPresentPaths": [
        "inputRequests.elicitation",
        "requestState"
      ],
      "stringResultPaths": [
        "requestState"
      ]
    },
    "ignorePaths": [
      "$body.result.requestState",
      "$messages.0.result.requestState"
    ]
  },
