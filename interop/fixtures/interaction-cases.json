    "request": {
      "mcpMethod": "tools/call",
      "mcpName": "test_input_required_result_elicitation",
      "id": "mrtr-elicit-2",
      "params": {
        "name": "test_input_required_result_elicitation",
        "arguments": {},
        "requestState": "${state}",
        "inputResponses": {
          "user_name": {
            "action": "accept",
            "content": {
              "name": "Alice"
            }
          },
