  {
    "id": "tasks-create-and-complete",
    "requirements": [
      "P18.01",
      "P18.02",
      "P18.03"
    ],
    "profile": "tasks",
    "clientCapabilities": {
      "extensions": {
        "io.modelcontextprotocol/tasks": {}
      }
    },
    "steps": [
      {
        "request": {
          "mcpMethod": "tools/call",
          "mcpName": "slow_compute",
          "id": "task-create",
          "params": {
            "name": "slow_compute",
            "arguments": {
              "seconds": 0,
              "label": "raw"
            }
          }
        },
        "assert": {
          "status": 200,
          "resultType": "task",
          "resultPresentPaths": [
            "taskId",
            "status",
            "createdAt",
            "lastUpdatedAt",
            "ttlMs",
            "pollIntervalMs"
          ],
          "stringResultPaths": [
            "taskId",
            "createdAt",
            "lastUpdatedAt"
          ]
        },
        "save": {
          "task": "result.taskId"
        }
      },
      {
        "request": {
          "mcpMethod": "tasks/get",
          "mcpName": "${task}",
          "id": "task-get-complete",
          "params": {
            "taskId": "${task}"
          }
        },
        "until": {
          "resultPath": "status",
          "equals": "completed"
        },
        "maxPolls": 20,
        "intervalMs": 100,
        "assert": {
          "status": 200,
          "resultType": "complete",
          "resultPath": {
            "status": "completed"
          },
          "resultPresentPaths": [
            "result.content"
          ]
        }
      }
    ],
    "ignorePaths": [
      "$steps.0.body.result.taskId",
      "$steps.0.body.result.createdAt",
      "$steps.0.body.result.lastUpdatedAt",
      "$steps.1.body.result.taskId",
      "$steps.1.body.result.createdAt",
      "$steps.1.body.result.lastUpdatedAt",
      "$body.result.taskId",
      "$body.result.createdAt",
      "$body.result.lastUpdatedAt",
      "$steps.0.body.result.content"
    ]
  },
  {
    "id": "tasks-input-update",
    "requirements": [
      "P18.02",
      "P18.04"
    ],
    "profile": "tasks",
    "clientCapabilities": {
      "elicitation": {},
      "extensions": {
        "io.modelcontextprotocol/tasks": {}
      }
    },
    "steps": [
      {
        "request": {
          "mcpMethod": "tools/call",
          "mcpName": "confirm_delete",
          "id": "task-input-create",
          "params": {
            "name": "confirm_delete",
            "arguments": {
              "filename": "raw.txt"
            }
          }
        },
        "assert": {
          "status": 200,
          "resultType": "task",
          "resultPresentPaths": [
            "taskId"
          ]
        },
        "save": {
          "task": "result.taskId"
        }
      },
      {
        "request": {
          "mcpMethod": "tasks/get",
          "mcpName": "${task}",
          "id": "task-input-poll",
          "params": {
            "taskId": "${task}"
          }
        },
        "until": {
          "resultPath": "status",
          "equals": "input_required"
        },
        "maxPolls": 20,
        "intervalMs": 100,
        "assert": {
          "status": 200,
          "resultType": "complete",
          "resultPath": {
            "status": "input_required"
          },
          "resultPresentPaths": [
            "inputRequests.confirm"
          ]
        }
      },
      {
        "request": {
          "mcpMethod": "tasks/update",
          "mcpName": "${task}",
          "id": "task-input-update",
          "params": {
            "taskId": "${task}",
            "inputResponses": {
              "confirm": {
                "action": "accept",
                "content": {
                  "confirm": true
                }
              },
              "unknown": {
                "action": "accept",
                "content": {
                  "ignored": true
                }
              }
            }
          }
        },
        "assert": {
          "status": 200,
          "resultType": "complete"
        }
      },
      {
        "request": {
          "mcpMethod": "tasks/get",
          "mcpName": "${task}",
          "id": "task-input-complete",
          "params": {
            "taskId": "${task}"
          }
        },
        "until": {
          "resultPath": "status",
          "equals": "completed"
        },
        "maxPolls": 20,
        "intervalMs": 100,
        "assert": {
          "status": 200,
          "resultType": "complete",
          "resultPath": {
            "status": "completed"
          },
          "resultPresentPaths": [
            "result.content"
          ]
        }
      }
    ],
    "ignorePaths": [
      "$steps.0.body.result.taskId",
      "$steps.0.body.result.createdAt",
      "$steps.0.body.result.lastUpdatedAt",
      "$steps.1.body.result.taskId",
      "$steps.1.body.result.createdAt",
      "$steps.1.body.result.lastUpdatedAt",
      "$steps.3.body.result.taskId",
      "$steps.3.body.result.createdAt",
      "$steps.3.body.result.lastUpdatedAt",
      "$body.result.taskId",
      "$body.result.createdAt",
      "$body.result.lastUpdatedAt",
      "$steps.0.body.result.content"
    ]
  },
